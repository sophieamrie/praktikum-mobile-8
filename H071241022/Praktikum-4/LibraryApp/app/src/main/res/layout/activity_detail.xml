<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header dengan cover -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#8B5E3C">

            <ImageView
                android:id="@+id/imgDetailCover"
                android:layout_width="140dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:elevation="8dp"/>

            <!-- Back button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="12dp"
                android:src="@android:drawable/ic_menu_revert"
                android:padding="4dp"/>

            <!-- Like button -->
            <ImageView
                android:id="@+id/btnLike"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:src="@android:drawable/btn_star_big_off"/>

        </FrameLayout>

        <!-- Book Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textColor="#5C3D2E"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDetailAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="by Author"
                android:textColor="#8B5E3C"
                android:textSize="15sp"
                android:layout_marginTop="4dp"/>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvDetailRating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4.5"
                    android:textColor="#8B5E3C"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvDetailYear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2024"
                    android:textColor="#8B5E3C"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvDetailPages"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="300 pages"
                    android:textColor="#8B5E3C"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="12dp"
                android:background="#D4A574"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/tvDetailPublisher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publisher"
                android:textColor="#8B5E3C"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D4A574"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- Blurb -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About this book"
                android:textColor="#5C3D2E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetailBlurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blurb"
                android:textColor="#8B5E3C"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>