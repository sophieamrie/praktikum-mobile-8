<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#8B5E3C"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Book"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Cover Image -->
            <ImageView
                android:id="@+id/imgCoverPreview"
                android:layout_width="120dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Tap to select cover image"
                android:textColor="#8B5E3C"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title *"
                android:textColor="#8B5E3C"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Book title"
                android:backgroundTint="#D4A574"
                android:layout_marginBottom="12dp"/>

            <!-- Author -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Author *"
                android:textColor="#8B5E3C"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Author name"
                android:backgroundTint="#D4A574"
                android:layout_marginBottom="12dp"/>

            <!-- Year -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Year *"
                android:textColor="#8B5E3C"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Publication year"
                android:inputType="number"
                android:backgroundTint="#D4A574"
                android:layout_marginBottom="12dp"/>

            <!-- Genre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre"
                android:textColor="#8B5E3C"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Fantasy, Thriller"
                android:backgroundTint="#D4A574"
                android:layout_marginBottom="12dp"/>

            <!-- Blurb -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blurb *"
                android:textColor="#8B5E3C"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etBlurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Short description"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:backgroundTint="#D4A574"
                android:layout_marginBottom="24dp"/>

            <!-- Button -->
            <Button
                android:id="@+id/btnAddBook"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Add Book"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B5E3C"
                android:textStyle="bold"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>